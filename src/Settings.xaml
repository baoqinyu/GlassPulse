<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource SettingsSurface}" TextElement.Foreground="{DynamicResource PrimaryText}" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#BEF5DA"/><Setter Property="SelectionBrush" Value="#548F7D"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#B8E5CE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="33" Height="19" CornerRadius="10" Background="{DynamicResource SwitchOff}" Margin="12,0,0,0"><Ellipse x:Name="SwitchKnob" Width="13" Height="13" Fill="#E0E9E5" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#A5D8BF"/><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchKnob" Property="Fill" Value="#203B33"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#F2FFF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#657E80" CornerRadius="2" Width="4" HorizontalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="23"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="2,0">
        <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#405858"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#C3EAD7" CornerRadius="8" BorderThickness="1" BorderBrush="#E0F8E9"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" CornerRadius="5" Padding="9,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#405B53"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C0EBD5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="8" Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"><Path Data="M0,0 L4,4 L8,0" Stroke="#BCD3C8" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Margin="10,8,30,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="180" Margin="0,4,0,0" CornerRadius="9" Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="5"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid Margin="25,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,15"><TextBlock Text="让它刚刚好。" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="GlassPulse  /  偏好设置" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="显示工具" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ProvidersInput"><ComboBoxItem Content="Codex + Claude"/><ComboBoxItem Content="仅 Codex"/><ComboBoxItem Content="仅 Claude"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="外观主题" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="ThemeInput"><ComboBoxItem Content="深色玻璃"/><ComboBoxItem Content="浅色玻璃"/></ComboBox></StackPanel>
        </Grid>
        <TextBlock Text="每周 API 等值预算 · USD" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="自由设置两种工具的预算；填写 0 表示不设置上限。" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Codex" FontSize="11" Foreground="{DynamicResource MintText}" Margin="0,0,0,5"/><TextBox x:Name="CodexBudgetInput" AutomationProperties.Name="Codex 每周预算，美元"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Claude" FontSize="11" Foreground="{DynamicResource PeachText}" Margin="0,0,0,5"/><TextBox x:Name="ClaudeBudgetInput" AutomationProperties.Name="Claude 每周预算，美元"/></StackPanel>
        </Grid>
        <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="每周开始于" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="WeekStartInput" Padding="7,5" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="每周起始日"><ComboBoxItem Content="星期一"/><ComboBoxItem Content="星期日"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="刷新间隔（秒）" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="RefreshInput" AutomationProperties.Name="刷新间隔，1 到 60 秒"/></StackPanel>
        </Grid>
        <TextBlock Text="玻璃浓度" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,8"/>
        <Slider x:Name="OpacityInput" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="玻璃背景浓度"/>
        <Grid Margin="0,3,0,3"><TextBlock Text="更通透" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="更清晰" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
        <CheckBox x:Name="TopmostInput" Content="保持在其他窗口上方"/>
        <CheckBox x:Name="MiniInput" Content="极简横条模式"/>
        <CheckBox x:Name="StartupInput" Content="登录 Windows 时启动"/>
        <TextBlock Text="本地日志目录" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,5"/>
        <TextBlock Text="选择 .codex / .claude 文件夹，可自定义其他位置。" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,10"/>
        <TextBlock Text="Codex" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="CodexRootInput" FontSize="10" AutomationProperties.Name="Codex 主目录"/>
        <TextBlock Text="Claude Code" FontSize="11" Margin="0,10,0,5"/><TextBox x:Name="ClaudeRootInput" FontSize="10" AutomationProperties.Name="Claude Code 主目录"/>
        <StackPanel Orientation="Horizontal" Margin="0,13,0,8"><Button x:Name="PricingButton" Content="编辑价格表 ↗" FontSize="10"/><Button x:Name="DataButton" Content="打开配置目录 ↗" FontSize="10" Margin="8,0,0,0"/></StackPanel>
        <TextBlock x:Name="PriceDate" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,5"/>
        <TextBlock Text="仅统计此电脑可读取的用量日志。金额按标准 API token 单价估算，不含工具调用费用、税费、地区和速度加价。数据不上传。" TextWrapping="Wrap" FontSize="10" LineHeight="16" Foreground="{DynamicResource Muted}" Margin="0,8,0,5"/>
        <TextBlock x:Name="ErrorText" Foreground="#F3B496" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="HotkeyHint" Text="Ctrl + Alt + G  隐藏 / 唤回" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" IsCancel="True"/><Button x:Name="SaveButton" Content="保存" Background="#B9E8D0" Foreground="#1A302A" IsDefault="True" Margin="8,0,0,0"/></StackPanel>
    </Grid>
  </Grid>
</Grid>
